# ── App ─────────────────────────────────
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGIN_REGEX=^(https://[a-z0-9-]+\.vercel\.app|http://(localhost|127\.0\.0\.1)(:\d{2,5})?)$

# ── Auth ────────────────────────────────
JWT_SECRET=change-me-to-a-random-string

# ── Supabase ────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGci...your-service-role-key

# ── Qdrant Cloud ────────────────────────
QDRANT_URL=https://xxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Cohere (Embeddings) ────────────────
COHERE_API_KEY=your-cohere-api-key

# ── Groq (LLM) ─────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key

# ── Bhashini (Translation) ─────────────
BHASHINI_API_URL=https://bhashini.gov.in/api
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_SERVICE_ID=
BHASHINI_API_KEY_HEADER=Authorization
BHASHINI_API_KEY_PREFIX=Bearer 
BHASHINI_PAYLOAD_STYLE=simple
BHASHINI_TIMEOUT_SECONDS=20

# ── Reranker ───────────────────────────
RERANK_MIN_SCORE=0.5

# ── Rate limiting ──────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_USE_REDIS=true
REDIS_URL=redis://redis:6379/0

# ── Observability ──────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
ENVIRONMENT=local

# ── Hybrid Search ──────────────────────
HYBRID_SEARCH_ENABLED=true
HYBRID_BM25_ENABLED=true
HYBRID_CANDIDATE_MULTIPLIER=5
HYBRID_RRF_K=60

# ── Feature Data ───────────────────────
# FEATURE_DATA_DIR=

# ── Kaggle Docling (ngrok) ──────────────
DOCLING_URL=https://xxxx-xx-xx.ngrok-free.app
